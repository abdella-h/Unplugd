FROM node:22-slim

WORKDIR /frontend

COPY package.json package-lock.json ./

RUN npm ci

COPY . .

# Proxy targets are baked into the Nitro server at build time, so the
# compose service names must be set before `npm run build`. Plain local
# builds keep the localhost defaults from nuxt.config.ts.
ENV NUXT_AUTH_API_URL=http://auth-service:8000
ENV NUXT_DEVICES_API_URL=http://devices-service:8000
ENV NUXT_DASHBOARD_API_URL=http://dashboard-service:8002

RUN npm run build

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

EXPOSE 3000

CMD [ "node", ".output/server/index.mjs" ]
